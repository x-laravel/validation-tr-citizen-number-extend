{
    "name": "x-laravel/validation-tr-citizen-number-extend",
    "description": "Turkey citizen number (TC No) validation extend package for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mehmet ÖĞMEN",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://www.mehmetogmen.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "x-adam/tr-citizen-number-validation": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "XLaravel\\ValidationTrCitizenNumberExtend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XLaravel\\ValidationTrCitizenNumberExtend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLaravel\\ValidationTrCitizenNumberExtend\\TrCitizenNumberServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    }
}
