{
    "name": "x-laravel/validation-tr-citizen-number-extend",
    "description": "Turkey citizen number (TC No) validation extend package for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mehmet ÖĞMEN",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://www.mehmetogmen.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "x-adam/tr-citizen-number-validation": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "XLaravel\\ValidationTrCitizenNumberExtend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XLaravel\\ValidationTrCitizenNumberExtend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLaravel\\ValidationTrCitizenNumberExtend\\Providers\\ValidationTrCitizenNumberExtendServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
